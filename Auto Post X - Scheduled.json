    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst day = String(now.getDate()).padStart(2, '0');\nconst month = String(now.getMonth() + 1).padStart(2, '0');\nconst today = `${day}/${month}/${now.getFullYear()}`;\n\nconst out = [];\n\nfor (const item of $input.all()) {\n  const d = String(item.json['Date'] || '').trim();\n  const s = String(item.json['Status'] || '').trim().toLowerCase();\n  const caption = String(item.json['Caption'] || '').trim();\n\n  if (d !== today || s === 'done' || !caption) continue;\n\n  const [dayPart, monthPart] = d.split('/');\n  item.json.filePattern = `${dayPart}.${monthPart}`;\n  out.push(item);\n}\n\nreturn out;"
      },
